# Скопировать в .env и заполнить. .env в git не попадает (.gitignore).
# Без этих значений оба текстовых эндпоинта работают детерминированно:
# разбор фразы — по ключевым словам, объяснение — по шаблону.

# Ключ сервисного аккаунта Yandex Cloud с ролью ai.languageModels.user
QATNOV_YC_API_KEY=
# Идентификатор каталога, в котором живёт модель
QATNOV_YC_FOLDER_ID=

# Необязательное. Значения по умолчанию — в app/config.py
# QATNOV_YC_MODEL=yandexgpt/latest
# QATNOV_YC_ENDPOINT=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
# строгий JSON при разборе фразы: schema (jsonSchema из proto) или object (jsonObject)
# QATNOV_YC_JSON_MODE=schema
# QATNOV_LLM_TIMEOUT_SEC=5
# рубильник: 1 — не ходить в модель вообще, идти детерминированным путём
# QATNOV_LLM_DISABLED=

# Пути к данным (по умолчанию — каталоги репозитория)
# QATNOV_DATA_RAW=
# QATNOV_DATA_EXTERNAL=
# QATNOV_DATA_BUILD=
